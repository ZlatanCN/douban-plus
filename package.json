{
  "name": "douban-plus",
  "version": "1.8.5",
  "description": "适配 ScriptCat 和 Tampermonkey 的豆瓣作品详情页与人物页增强脚本，用 Preact 重排为 Apple TV 风格沉浸式暗色界面，并保留豆瓣原生登录、标记和跳转能力。",
  "keywords": [
    "apple-tv",
    "douban",
    "scriptcat",
    "tampermonkey",
    "userscript"
  ],
  "license": "MIT",
  "author": "Gabriel Zhu",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx tests/qa.ts",
    "qa:ratings-live": "DP_LIVE_RATING_AUDIT=1 vitest run tests/qa/live-rating-audit-runtime.test.tsx --reporter=verbose",
    "lint": "ultracite check && stylelint \"src/**/*.css\" && node scripts/css-audit/index.mjs",
    "check:css": "node scripts/css-audit/index.mjs",
    "fix": "ultracite fix && stylelint \"src/**/*.css\" --fix",
    "format": "ultracite fix",
    "typecheck": "tsc && tsc -p tests/tsconfig.json",
    "ci": "pnpm lint && tsc && tsc -p tests/tsconfig.json && vitest run && vite build && tsx tests/qa.ts"
  },
  "dependencies": {
    "motion": "^14.14.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.2",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "postcss-selector-parser": "^7.2.1",
    "postcss-value-parser": "^4.2.0",
    "stylelint": "^18.0.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-prettier": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "^8.2.0",
    "vite": "^8.3.8",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
